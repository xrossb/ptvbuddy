{
  "name": "ptvbuddy",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "ptvbuddy",
    "uuid": "674f492e-1df6-4c58-a06a-1c23383f4378",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Kind",
      "FavouriteCount",
      "FavouriteRouteTypes[8]",
      "FavouriteStopIDs[8]",
      "FavouriteRouteIDs[8]",
      "FavouriteDisplayNames[8]",
      "StopsCount",
      "StopIDs[12]",
      "StopDistances[12]",
      "StopNames[12]",
      "RoutesCount",
      "RouteTypes[16]",
      "RouteIDs[16]",
      "RouteNames[16]",
      "DeparturesCount",
      "DepartureETAs[12]",
      "DepartureFlags[12]",
      "DepartureHeadsigns[12]",
      "StopID",
      "RouteID"
    ],
    "resources": {
      "media": [
        {
          "file": "images/location.png",
          "type": "bitmap",
          "name": "IMAGE_LOCATION"
        },
        {
          "file": "images/train.png",
          "type": "bitmap",
          "name": "IMAGE_ICON_TRAIN"
        },
        {
          "file": "images/tram.png",
          "type": "bitmap",
          "name": "IMAGE_ICON_TRAM"
        },
        {
          "file": "images/bus.png",
          "type": "bitmap",
          "name": "IMAGE_ICON_BUS"
        },
        {
          "file": "images/vline.png",
          "type": "bitmap",
          "name": "IMAGE_ICON_VLINE"
        },
        {
          "file": "images/night_bus.png",
          "type": "bitmap",
          "name": "IMAGE_ICON_NIGHT_BUS"
        }
      ]
    }
  },
  "scripts": {
    "fmt": "prettier -w .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@types/webpack-env": "^1.18.8",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
